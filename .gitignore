# ==============================================================================
# .gitignore for PawHaven BD
# ==============================================================================

# ------------------------------------------------------------------------------
# .NET / C# Build & Compiler Artifacts
# ------------------------------------------------------------------------------
bin/
obj/
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
*.user
*.userosscache
*.suo
*.userprefs
*.sln.docstates
*.pidb
*.booproj
PublishScripts/
publish/
*.publishproj
.nuget/
project.lock.json
project.fragment.lock.json
artifacts/
Generated_Files/
_ReSharper*/
*.ReSharper

# ------------------------------------------------------------------------------
# Node.js / Frontend (if tooling or node_modules are introduced)
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
dist/
out/
build/
.cache/

# ------------------------------------------------------------------------------
# Python & Test Suite Artifacts
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# ------------------------------------------------------------------------------
# Local Environment & Secrets (NEVER COMMIT)
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.local.json
appsettings.*.local.json
appsettings.local.json

# ------------------------------------------------------------------------------
# IDEs & Code Editors
# ------------------------------------------------------------------------------
# Visual Studio
.vs/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains (Rider, PyCharm, WebStorm)
.idea/
*.iws
*.iml
*.ipr
.idea_modules/

# Miscellaneous Editors
*.swp
*.swo
*~
*.bak

# ------------------------------------------------------------------------------
# Operating System Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ------------------------------------------------------------------------------
# Logs, Dumps & Temp Files
# ------------------------------------------------------------------------------
*.log
logs/
*.tmp
*.temp
*.crash
*.dump
