# PawHaven BD - Environment Configuration Template
# Copy this file to .env or export these variables in your shell / hosting environment.

# ==============================================================================
# Database Configuration
# ==============================================================================
# Override connection string for ASP.NET Core
ConnectionStrings__DefaultConnection="Server=127.0.0.1;Port=3306;Database=pet_ecommerce_db;User=root;Password=YOUR_MYSQL_PASSWORD;CharSet=utf8mb4;"

# Alternative env var recognized by Program.cs
MYSQL_CONNECTION_STRING="Server=127.0.0.1;Port=3306;Database=pet_ecommerce_db;User=root;Password=YOUR_MYSQL_PASSWORD;CharSet=utf8mb4;"

# MySQL client automation user (used by sql/setup_database.sh)
MYSQL_USER=root

# ==============================================================================
# JWT Authentication
# ==============================================================================
Jwt__SecretKey="YOUR_SUPER_SECRET_KEY_AT_LEAST_32_CHARACTERS_LONG_FOR_HMAC_SHA256"
Jwt__Issuer="PetHavenApi"
Jwt__Audience="PetHavenClient"
Jwt__ExpiryInMinutes=120
Jwt__RefreshTokenExpiryInDays=14

# ==============================================================================
# ASP.NET Core Runtime
# ==============================================================================
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS="http://localhost:5208;https://localhost:7080"
